{
  "name": "videojs-hlsjs-live-timeline",
  "version": "0.1.0",
  "description": "Video.js v10 elements and React components for live HLS with hls.js: clock time from EXT-X-PROGRAM-DATE-TIME, and live chapters from SCTE-35 breaks or a schedule.",
  "keywords": [
    "chapters",
    "custom-element",
    "daterange",
    "dvr",
    "hls",
    "hls.js",
    "live",
    "program-date-time",
    "react",
    "scte-35",
    "video.js",
    "videojs"
  ],
  "homepage": "https://pbs.github.io/videojs-hlsjs-live-timeline/",
  "bugs": {
    "url": "https://github.com/pbs/videojs-hlsjs-live-timeline/issues"
  },
  "license": "MIT",
  "author": "PBS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbs/videojs-hlsjs-live-timeline.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode library && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "preview:demo": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/core": "^10.0.1",
    "@videojs/element": "^10.0.1",
    "@videojs/hlsjs-video": "^10.0.1",
    "@videojs/html": "^10.0.1",
    "@videojs/react": "^10.0.1",
    "happy-dom": "^20.9.0",
    "hls.js": "^1.7.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "videojs-hlsjs-iframe-thumbnail": "^0.1.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@videojs/element": "^10.0.0",
    "@videojs/html": "^10.0.0",
    "@videojs/react": "^10.0.0",
    "hls.js": "^1.6.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@videojs/html": {
      "optional": true
    },
    "@videojs/react": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "hls.js": "$hls.js"
  }
}
